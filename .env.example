# Ejemplo local. El proyecto lee el entorno del proceso; no carga .env automáticamente.
# Bash: set -a; source .env; set +a   (solo archivos propios y confiables)
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Vacía en desarrollo: SQLite. PostgreSQL local: conexión de una base desechable.
DATABASE_URL=

# Producción: sustituir valores en el panel de Vercel, sin subir secretos a GitHub.
# DEBUG=False
# SECRET_KEY=<clave aleatoria de al menos 50 caracteres>
# ALLOWED_HOSTS=asistencias.example.org,proyecto.vercel.app
# CSRF_TRUSTED_ORIGINS=https://asistencias.example.org,https://proyecto.vercel.app
# DATABASE_URL=postgresql://usuario:CLAVE_CODIFICADA@host-pooler/base?sslmode=require
# VERCEL=1 la establece la plataforma; no activarla en desarrollo.

# Solo terminal autorizada para migraciones/respaldos; no las necesita Vercel.
# DIRECT_DATABASE_URL=postgresql://usuario:CLAVE_CODIFICADA@host/base?sslmode=require
# RESTORE_DATABASE_URL=postgresql://usuario:CLAVE_CODIFICADA@otro-host/base_vacia?sslmode=require
